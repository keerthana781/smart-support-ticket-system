# Copy this file to ".env" and fill in your values.
# ".env" is listed in .gitignore, so your real keys are never pushed to GitHub.

# Free key from https://aistudio.google.com/apikey  (leave empty to use offline keyword rules)
GEMINI_API_KEY=

# Check Google AI Studio for the current model names if this one is retired.
GEMINI_MODEL=gemini-2.5-flash

# "gemini" or "rules"
AI_PROVIDER=gemini

# Any long random Base64 string. Generate one with:  openssl rand -base64 48
JWT_SECRET=

DB_PASSWORD=supportdesk

# Create demo users and tickets on first start
SEED_DEMO_DATA=true
